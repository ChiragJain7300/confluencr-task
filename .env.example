# Application Port
PORT=3001

# Supabase PostgreSQL Connection Pooler URL (IPv4 compatible)
DB_SUPABASE_CONN_STR="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis Connection URL (TLS/SSL enabled)
REDIS_URL="rediss://default:[TOKEN]@[HOST].upstash.io:6379"
